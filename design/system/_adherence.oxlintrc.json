{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/document/**",
              "components/feedback/**",
              "components/forms/**",
              "components/lists/**",
              "ui_kits/iphone/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cormorant Garamond|Lora))/i]",
        "message": "Font not provided by the design system. Available: Cormorant Garamond, Lora."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|children|fullWidth|disabled|busy|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, children, fullWidth, disabled, busy, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|destructive|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'destructive' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|body|confirmLabel|cancelLabel|onConfirm|onCancel|style|key|ref|className|style|children)$/]",
        "message": "<ConfirmDialog> doesn't accept that prop. Declared props: title, body, confirmLabel, cancelLabel, onConfirm, onCancel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|body|action|style|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, title, body, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ErrorLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<ErrorLine> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|outlined|disabled|size|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, outlined, disabled, size, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|icon|destructive|disabled|key|ref|className|style|children)$/]",
        "message": "<MenuItem> doesn't accept that prop. Declared props: label, icon, destructive, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageCounter'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|onDark|style|key|ref|className|style|children)$/]",
        "message": "<PageCounter> doesn't accept that prop. Declared props: children, onDark, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageImage'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|state|grey|label|refusedText|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PageImage> doesn't accept that prop. Declared props: src, alt, state, grey, label, refusedText, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageImage'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:page|refused)$/]",
        "message": "<PageImage> state must be one of 'page' | 'refused'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:line|note|value|max|style|key|ref|className|style|children)$/]",
        "message": "<ProgressLine> doesn't accept that prop. Declared props: line, note, value, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|thumb|thumbSrc|swiped|deleteLabel|onPress|onDelete|style|key|ref|className|style|children)$/]",
        "message": "<ScanRow> doesn't accept that prop. Declared props: title, subtitle, thumb, thumbSrc, swiped, deleteLabel, onPress, onDelete, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Shutter'] > JSXAttribute > JSXIdentifier[name!=/^(?:disabled|onPress|label|style|key|ref|className|style|children)$/]",
        "message": "<Shutter> doesn't accept that prop. Declared props: disabled, onPress, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|min|max|step|unit|minLabel|maxLabel|suggested|disabled|onChange|style|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: label, value, min, max, step, unit, minLabel, maxLabel, suggested, disabled, onChange, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|sub|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, sub, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|quiet)$/]",
        "message": "<Tag> tone must be one of 'neutral' | 'accent' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|placeholder|onChange|suffix|disabled|style|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, value, placeholder, onChange, suffix, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Viewfinder'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|note|corners|style|key|ref|className|style|children)$/]",
        "message": "<Viewfinder> doesn't accept that prop. Declared props: children, note, corners, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
